<Window x:Class="PixShell.HostEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="主机"
        Width="380" MinWidth="320" MinHeight="280" Height="480"
        SizeToContent="Manual"
        Tag="NoAutoResize"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        WindowStyle="ToolWindow"
        Background="{DynamicResource BrushBg}"
        ShowInTaskbar="False"
        Foreground="{DynamicResource BrushText}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,4,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="48"/>
                <ColumnDefinition Width="*" MinWidth="120"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="类型" VerticalAlignment="Center" Margin="0,4"
                       Foreground="{DynamicResource BrushMuted}"/>
            <ComboBox  Grid.Row="0" Grid.Column="1" Name="TypeBox" Margin="8,4,0,4" SelectionChanged="OnTypeChanged">
                <ComboBoxItem Content="SSH"/>
                <ComboBoxItem Content="RDP（远程桌面）"/>
            </ComboBox>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="名称" VerticalAlignment="Center" Margin="0,4"
                       Foreground="{DynamicResource BrushMuted}"/>
            <TextBox   Grid.Row="1" Grid.Column="1" Name="NameBox" Margin="8,4,0,4"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="主机" VerticalAlignment="Center" Margin="0,4"
                       Foreground="{DynamicResource BrushMuted}"/>
            <TextBox   Grid.Row="2" Grid.Column="1" Name="HostBox" Margin="8,4,0,4"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="端口" VerticalAlignment="Center" Margin="0,4"
                       Foreground="{DynamicResource BrushMuted}"/>
            <TextBox   Grid.Row="3" Grid.Column="1" Name="PortBox" Text="22" Margin="8,4,0,4"/>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="用户名" VerticalAlignment="Center" Margin="0,4"
                       Foreground="{DynamicResource BrushMuted}"/>
            <TextBox   Grid.Row="4" Grid.Column="1" Name="UserBox" Margin="8,4,0,4"/>

            <TextBlock Grid.Row="5" Grid.Column="0" Text="密码" VerticalAlignment="Center" Margin="0,4"
                       Foreground="{DynamicResource BrushMuted}"/>
            <PasswordBox Grid.Row="5" Grid.Column="1" Name="PassBox" Margin="8,4,0,4"/>

            <TextBlock Grid.Row="6" Grid.Column="0" Text="分组" VerticalAlignment="Center" Margin="0,4"
                       Foreground="{DynamicResource BrushMuted}"/>
            <TextBox   Grid.Row="6" Grid.Column="1" Name="GroupBox" Text="默认" Margin="8,4,0,4"/>

            <TextBlock Grid.Row="7" Grid.Column="0" Text="系统" VerticalAlignment="Center" Margin="0,4"
                       Foreground="{DynamicResource BrushMuted}"/>
            <ComboBox  Grid.Row="7" Grid.Column="1" Name="OsBox" Margin="8,4,0,4" IsEditable="False">
                <ComboBoxItem Content=""/>
                <ComboBoxItem Content="linux"/>
                <ComboBoxItem Content="ubuntu"/>
                <ComboBoxItem Content="debian"/>
                <ComboBoxItem Content="centos"/>
                <ComboBoxItem Content="alpine"/>
                <ComboBoxItem Content="openwrt"/>
                <ComboBoxItem Content="windows"/>
                <ComboBoxItem Content="macos"/>
            </ComboBox>

            <TextBlock Grid.Row="8" Grid.Column="0" Text="私钥" VerticalAlignment="Center" Margin="0,4"
                       Foreground="{DynamicResource BrushMuted}"/>
            <Grid Grid.Row="8" Grid.Column="1" Margin="8,4,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="80"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Name="KeyPathBox"
                         ToolTip="留空则使用密码登录" Margin="0,0,6,0"/>
                <Button  Grid.Column="1" Content="选择…" MinWidth="56" Padding="8,3" Click="OnChooseKeyFile" Style="{StaticResource PillButton}"/>
            </Grid>

            <TextBlock Grid.Row="9" Grid.Column="0" Text="代理" VerticalAlignment="Center" Margin="0,4"
                       Foreground="{DynamicResource BrushMuted}"/>
            <ComboBox  Grid.Row="9" Grid.Column="1" Name="ProxyBox" Margin="8,4,0,4"/>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="保存" Tag="Primary" Style="{StaticResource PillButton}" MinWidth="72" Padding="14,4" Margin="0,0,8,0" IsDefault="True" Click="OnSave"/>
            <Button Content="取消" Style="{StaticResource PillButton}" MinWidth="72" Padding="14,4" IsCancel="True" Click="OnCancel"/>
        </StackPanel>
    </Grid>
</Window>
