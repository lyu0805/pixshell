<Window x:Class="PixShell.UI.ConnectionManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="连接管理器"
        Width="360" Height="320"
        MinWidth="280" MinHeight="220"
        Tag="NoAutoResize"
        ResizeMode="CanResizeWithGrip"
        WindowStyle="ToolWindow"
        Background="{DynamicResource BrushBg}"
        Foreground="{DynamicResource BrushText}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        KeyDown="Window_KeyDown">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题行：窄宽时按钮可换行，严禁与列表重叠 -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12" LastChildFill="True">
            <Button DockPanel.Dock="Right" Content="关闭" Style="{StaticResource PillButton}"
                    FontSize="11" Padding="10,3" Click="Close_Click"/>
            <Button DockPanel.Dock="Right" Content="＋主机" Tag="Primary" Style="{StaticResource PillButton}"
                    FontSize="11" Padding="10,3" Margin="0,0,6,0" Click="New_Click"/>
            <Button DockPanel.Dock="Right" Content="＋分组" Style="{StaticResource PillButton}"
                    FontSize="11" Padding="10,3" Margin="0,0,6,0" Click="NewGroup_Click"/>
            <TextBlock Text="连接管理器" FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource BrushText}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
        </DockPanel>

        <!-- 搜索：机器多时按名称/地址/用户/分组/系统过滤（对齐 mac ConnManager） -->
        <Border Grid.Row="1" Margin="0,0,0,10"
                Background="{DynamicResource BrushBg2}" BorderBrush="{DynamicResource BrushBorder}"
                BorderThickness="1" CornerRadius="{DynamicResource RadiusSm}">
            <Grid>
                <TextBox x:Name="SearchBox" BorderThickness="0" Background="Transparent"
                         FontSize="12" Padding="10,5" VerticalContentAlignment="Center"
                         Foreground="{DynamicResource BrushText}"
                         TextChanged="SearchBox_TextChanged"/>
                <!-- 占位符：SearchBox 为空时显示，输入即隐（默认 TextBox 样式无 watermark，故自绘） -->
                <TextBlock x:Name="SearchHint" Text="搜索主机…（名称 / 地址 / 用户 / 分组）"
                           IsHitTestVisible="False" FontSize="12" Margin="11,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource BrushMuted}"/>
            </Grid>
        </Border>

        <!-- ScrollViewer：内容溢出时显示垂直滑块 -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Visible"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="ListPanel"/>
        </ScrollViewer>
    </Grid>
</Window>
