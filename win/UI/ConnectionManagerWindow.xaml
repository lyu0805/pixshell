<Window x:Class="PixShell.UI.ConnectionManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="连接管理器" Width="660" Height="580"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        MouseLeftButtonDown="Window_MouseLeftButtonDown" KeyDown="Window_KeyDown">
    <!-- 独立窗口增加外边距，以留出阴影空间 -->
    <Border x:Name="Card" Background="{DynamicResource BrushBg2}" BorderBrush="{DynamicResource BrushBorderStrong}"
            BorderThickness="1" CornerRadius="{DynamicResource RadiusLg}" Margin="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.3" Direction="270" />
        </Border.Effect>
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="连接管理器" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}" VerticalAlignment="Center"/>
                <Button DockPanel.Dock="Right" Content="关闭" Style="{StaticResource PillButton}" Click="Close_Click"/>
                <Button DockPanel.Dock="Right" Content="＋ 新建主机" Tag="Primary" Style="{StaticResource PillButton}"
                        Margin="0,0,8,0" Click="New_Click"/>
                <Button DockPanel.Dock="Right" Content="＋分组" Style="{StaticResource PillButton}"
                        Margin="0,0,8,0" Click="NewGroup_Click"/>
            </DockPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ListPanel"/>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
