<UserControl x:Class="PixShell.UI.ToolsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True" KeyDown="Root_KeyDown" MouseDown="Root_MouseDown">
    <!-- 独立 Owner 窗口承载（ToolsPanel.Show/EnsureHost），禁止盖 WebView2 再藏终端。
         卡片默认约原先一半宽（180→不再 360），可随 host 窗口缩放；下载列表可滚，严禁重叠。 -->
    <Grid Margin="8">
        <Border x:Name="Card" MinWidth="200" MaxWidth="420" Width="220"
                Background="{DynamicResource BrushBg2}"
                BorderBrush="{DynamicResource BrushBorderStrong}" BorderThickness="1"
                CornerRadius="{DynamicResource RadiusMd}" MouseDown="Card_MouseDown">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="3" Direction="270" Opacity="0.3" Color="Black"/>
            </Border.Effect>
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="64"/>
                </Grid.RowDefinitions>

                <!-- 标题行 + 显式关闭 -->
                <DockPanel Grid.Row="0" Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right" Content="✕" Width="24" Height="24"
                            Style="{StaticResource IconButton}" ToolTip="关闭" Click="Close_Click"/>
                    <TextBlock Text="工具 / 下载" FontWeight="SemiBold" FontSize="12"
                               Foreground="{DynamicResource BrushText}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </DockPanel>

                <ComboBox x:Name="HostCombo" Grid.Row="1" Margin="0,0,0,6" FontSize="11"
                          SelectionChanged="HostCombo_SelectionChanged"/>

                <WrapPanel Grid.Row="2" Margin="0,0,0,6">
                    <Button Content="路由" Style="{StaticResource PillButton}" FontSize="10" Padding="8,3" Margin="0,0,4,4" Click="Route_Click"/>
                    <Button Content="进程" Style="{StaticResource PillButton}" FontSize="10" Padding="8,3" Margin="0,0,4,4" Click="Process_Click"/>
                    <Button Content="网络" Style="{StaticResource PillButton}" FontSize="10" Padding="8,3" Margin="0,0,4,4" Click="Network_Click"/>
                    <Button Content="测速" Style="{StaticResource PillButton}" FontSize="10" Padding="8,3" Margin="0,0,4,4" Click="Speed_Click"/>
                </WrapPanel>

                <DockPanel Grid.Row="3" Margin="0,0,0,6">
                    <TextBlock Text="下载" DockPanel.Dock="Left" FontWeight="SemiBold" FontSize="11"
                               Foreground="{DynamicResource BrushMuted}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <Button DockPanel.Dock="Right" Content="&#xE8DA;" ToolTip="打开下载目录"
                            FontFamily="Segoe MDL2 Assets" FontSize="11"
                            Style="{StaticResource IconButton}" Width="24" Height="24" Margin="2,0,0,0" Click="OpenDir_Click"/>
                    <Button DockPanel.Dock="Right" Content="&#xE8B7;" ToolTip="选择下载目录"
                            FontFamily="Segoe MDL2 Assets" FontSize="11"
                            Style="{StaticResource IconButton}" Width="24" Height="24" Click="PickDir_Click"/>
                    <TextBlock x:Name="DlPathText" Text="-" FontFamily="{DynamicResource FontMono}" FontSize="10"
                               Foreground="{DynamicResource BrushText}" VerticalAlignment="Center" Margin="0,0,4,0"
                               TextTrimming="CharacterEllipsis"/>
                </DockPanel>

                <Border Grid.Row="4" MinHeight="64" MaxHeight="160" Background="{DynamicResource BrushBg}"
                        BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                        CornerRadius="{DynamicResource RadiusSm}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid>
                            <TextBlock x:Name="DlEmpty" Text="暂无下载任务" FontSize="10"
                                       Foreground="{DynamicResource BrushMuted}"
                                       HorizontalAlignment="Center" Margin="0,8,0,0"/>
                            <StackPanel x:Name="DlList" Margin="0,2,0,2"/>
                        </Grid>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
