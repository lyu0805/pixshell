<UserControl x:Class="PixShell.UI.ToolsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True" KeyDown="Root_KeyDown" MouseDown="Root_MouseDown">
    <!-- 工具浮窗（顶栏宫格图标）。**这是一个小浮窗，不是独立界面。**
         老仓库 .flyout-panel：width 360 / padding 12 / 固定在顶栏下方靠右，点图标呼出、再点收起。
         内容以「下载任务」为主；工具按钮的输出走 ToolResultWindow 独立窗口，不塞在这 360px 里。
         对齐 mac UI/ToolsPanel.swift + UI/ToolResultWindow.swift。 -->
    <!-- 背景透明：只做"点外面收起"的捕获层，不再压半透明黑幕（那会让整个 App 像开了模态弹窗）。 -->
    <Grid Background="Transparent">
        <Border x:Name="Card" Width="360" MouseDown="Card_MouseDown"
                Background="{DynamicResource BrushBg2}" BorderBrush="{DynamicResource BrushBorderStrong}"
                BorderThickness="1" CornerRadius="{DynamicResource RadiusMd}"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,40,0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.35" Color="Black"/>
            </Border.Effect>
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ComboBox x:Name="HostCombo" Grid.Row="0" Margin="0,0,0,10" SelectionChanged="HostCombo_SelectionChanged"/>

                <WrapPanel Grid.Row="1" Margin="0,0,0,10">
                    <Button Content="路由追踪" Style="{StaticResource PillButton}" FontSize="11" Margin="0,0,6,6" Click="Route_Click"/>
                    <Button Content="进程管理" Style="{StaticResource PillButton}" FontSize="11" Margin="0,0,6,6" Click="Process_Click"/>
                    <Button Content="网络监控" Style="{StaticResource PillButton}" FontSize="11" Margin="0,0,6,6" Click="Network_Click"/>
                    <Button Content="速度测试" Style="{StaticResource PillButton}" FontSize="11" Margin="0,0,6,6" Click="Speed_Click"/>
                    <Button Content="自定义加速" Style="{StaticResource PillButton}" FontSize="11" Margin="0,0,6,6" Click="Accel_Click"/>
                </WrapPanel>

                <DockPanel Grid.Row="2" Margin="0,0,0,8">
                    <TextBlock Text="下载:" DockPanel.Dock="Left" FontWeight="SemiBold" FontSize="12"
                               Foreground="{DynamicResource BrushMuted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <Button DockPanel.Dock="Right" Content="&#xE8DA;" ToolTip="打开下载目录"
                            FontFamily="Segoe MDL2 Assets" FontSize="12"
                            Style="{StaticResource IconButton}" Margin="4,0,0,0" Click="OpenDir_Click"/>
                    <Button DockPanel.Dock="Right" Content="&#xE8B7;" ToolTip="选择下载目录"
                            FontFamily="Segoe MDL2 Assets" FontSize="12"
                            Style="{StaticResource IconButton}" Click="PickDir_Click"/>
                    <TextBlock x:Name="DlPathText" Text="-" FontFamily="{DynamicResource FontMono}" FontSize="11"
                               Foreground="{DynamicResource BrushText}" VerticalAlignment="Center" Margin="0,0,6,0"
                               TextTrimming="CharacterEllipsis"/>
                </DockPanel>

                <!-- 下载任务框：老仓库 .tools-dl-box 高 120 -->
                <Border Grid.Row="3" Height="120" Background="{DynamicResource BrushBg}"
                        BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                        CornerRadius="{DynamicResource RadiusSm}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <TextBlock x:Name="DlEmpty" Text="下载任务将显示在这里" FontSize="11"
                                       Foreground="{DynamicResource BrushMuted}"
                                       HorizontalAlignment="Center" Margin="0,10,0,0"/>
                            <StackPanel x:Name="DlList" Margin="0,4,0,4"/>
                        </Grid>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
