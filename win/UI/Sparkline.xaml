<UserControl x:Class="PixShell.UI.Sparkline"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 滚动窗口迷你图（网络吞吐量 / 网关延迟），对齐 mac UI/MonitorSidebar.swift 的 Sparkline。
         BarMode=true 时画柱状矩形，false 时画折线。 -->
    <Border Background="{DynamicResource BrushBg2}" CornerRadius="{DynamicResource RadiusSm}"
            BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" ClipToBounds="True">
        <Grid x:Name="Root" SizeChanged="Root_SizeChanged">
            <Canvas x:Name="BarCanvas" Visibility="Collapsed"/>
            <Polyline x:Name="Line" StrokeThickness="1.5"/>
        </Grid>
    </Border>
</UserControl>
