<UserControl x:Class="PixShell.UI.ConnectOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed" IsHitTestVisible="False">
    <!-- 连接动画（覆盖终端区）。连接过程属于 App 自己的 UI，不该往终端里写字
         —— 终端里只应该有远端的真实输出（对齐 mac UI/ConnectOverlay.swift）。
         观感参考 Termius：脉冲圆点 + 主机名 + 分步状态 + 不确定进度条。 -->
    <Grid x:Name="Root" Background="{DynamicResource BrushTerm}" Opacity="0.96">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

            <!-- 脉冲圆点：外圈一圈圈扩散 -->
            <Grid Width="44" Height="44" HorizontalAlignment="Center" Margin="0,0,0,12">
                <Ellipse x:Name="PulseRing" Width="34" Height="34" Fill="{DynamicResource BrushAccent}"
                         Opacity="0.35" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <ScaleTransform x:Name="PulseScale" ScaleX="0.45" ScaleY="0.45"/>
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse x:Name="PulseCore" Width="12" Height="12" Fill="{DynamicResource BrushAccent}"/>
            </Grid>

            <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" TextAlignment="Center"
                       Foreground="{DynamicResource BrushText}" Margin="0,0,0,6"/>
            <TextBlock x:Name="StepText" FontSize="12" TextAlignment="Center"
                       Foreground="{DynamicResource BrushMuted}" Margin="0,0,0,12"/>

            <!-- 不确定进度条：一段高亮来回滑动 -->
            <Border Width="220" Height="3" CornerRadius="2" Background="{DynamicResource BrushFill}"
                    ClipToBounds="True" HorizontalAlignment="Center">
                <Border x:Name="BarChunk" Width="70" Height="3" CornerRadius="2"
                        Background="{DynamicResource BrushAccent}" HorizontalAlignment="Left">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="BarShift" X="-70"/>
                    </Border.RenderTransform>
                </Border>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
