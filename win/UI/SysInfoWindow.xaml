<Window x:Class="PixShell.UI.SysInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="系统信息" Width="700" Height="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushBg}"
        Foreground="{DynamicResource BrushText}">
    <!-- 结构化系统信息面板：卡片 + 表格 + 药丸进度条，替换旧版纯文本弹窗。
         对齐 mac UI/SysInfoPanel.swift + Monitor/SysInfoParser.swift。 -->
    <DockPanel Margin="14">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" Text="系统信息" FontSize="15" FontWeight="SemiBold"
                       Foreground="{DynamicResource BrushText}" VerticalAlignment="Center"/>
            <Button x:Name="CloseBtn" DockPanel.Dock="Right" Content="关闭" Style="{StaticResource PillButton}"
                    Click="CloseBtn_Click" Margin="8,0,0,0"/>
            <Button x:Name="RefreshBtn" DockPanel.Dock="Right" Content="刷新" Style="{StaticResource PillButton}"
                    Click="RefreshBtn_Click"/>
        </DockPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="CardsPanel" Orientation="Vertical"/>
        </ScrollViewer>
    </DockPanel>
</Window>
