<Window x:Class="PixShell.UI.ProxyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="代理管理" Width="560" Height="460"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushBg}"
        Foreground="{DynamicResource BrushText}">
    <!-- 代理管理面板：列表(新建/编辑/删除)。对齐 mac UI/ProxyPanel.swift。 -->
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="代理管理" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}"/>
            <Button DockPanel.Dock="Right" Content="关闭" Style="{StaticResource PillButton}" Click="Close_Click"/>
            <Button DockPanel.Dock="Right" Content="＋新建代理" Tag="Primary" Style="{StaticResource PillButton}"
                    Margin="0,0,8,0" Click="New_Click"/>
        </DockPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ListPanel"/>
        </ScrollViewer>
    </Grid>
</Window>
