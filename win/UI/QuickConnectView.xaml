<UserControl x:Class="PixShell.UI.QuickConnectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <!-- 快速连接 / 历史 落地页：无活动会话时占据工作区中央。
         标题「快速连接（历史·N）」+ ＋新建/清空历史；主机卡片网格。
         对齐 mac UI/QuickConnect.swift。 -->
    <Grid Margin="24,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,24">
            <TextBlock x:Name="TitleText" Text="快速连接（历史 · 0）" FontSize="20" FontWeight="Bold"
                       Foreground="{DynamicResource BrushText}" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,0,0,0">
                <Button Content="＋ 新建" Style="{StaticResource PillButton}" Margin="0,0,8,0" Click="New_Click"/>
                <Button Content="清空历史" Style="{StaticResource PillButton}" Click="Clear_Click"/>
            </StackPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <WrapPanel x:Name="CardsPanel" Orientation="Horizontal"/>
                <TextBlock x:Name="EmptyHint" Text="暂无历史记录 —— 点右上角 ＋ 新建连接，或打开连接管理器"
                           Foreground="{DynamicResource BrushMuted}" FontSize="13" Margin="0,24,0,0"
                           Visibility="Collapsed"/>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
