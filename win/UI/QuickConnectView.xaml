<UserControl x:Class="PixShell.UI.QuickConnectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BrushBg}">
    <!-- 快速连接 / 历史 落地页：无活动会话时占据工作区中央。
         标题「快速连接（历史·N）」+ ＋新建/清空历史；主机卡片网格。
         对齐 mac UI/QuickConnect.swift。 -->
    <Grid Margin="24,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,24" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- 新建连接左侧 App logo，高度对齐按钮，点击打开本机终端 -->
                <Button x:Name="LogoBtn" Width="30" Height="30" Margin="0,0,10,0"
                        ToolTip="打开本机终端" Click="LocalTerm_Click"
                        Style="{StaticResource IconButton}" Padding="0"
                        Background="Transparent" BorderThickness="0" Cursor="Hand">
                    <Image x:Name="LogoImage" Width="28" Height="28" Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Button>
                <Button Content="＋ 新建" Style="{StaticResource PillButton}" Margin="0,0,8,0" Click="New_Click"/>
                <Button Content="清空历史" Style="{StaticResource PillButton}" Click="Clear_Click"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- 有活动会话时显示；点了回当前终端 -->
                <Button x:Name="BackBtn" Content="←" Width="32" Height="28" FontSize="16"
                        ToolTip="返回当前会话" Margin="0,0,10,0" Visibility="Collapsed"
                        Style="{StaticResource IconButton}" Click="Back_Click"/>
                <TextBlock x:Name="TitleText" Text="快速连接（历史 · 0）" FontSize="20" FontWeight="Bold"
                           Foreground="{DynamicResource BrushText}" VerticalAlignment="Center"/>
            </StackPanel>
        </DockPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" VerticalAlignment="Stretch">
            <Grid>
                <WrapPanel x:Name="CardsPanel" Orientation="Horizontal" HorizontalAlignment="Center"/>
                <TextBlock x:Name="EmptyHint" Text="暂无历史记录 —— 点右上角 ＋ 新建连接，或打开连接管理器"
                           Foreground="{DynamicResource BrushMuted}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="Collapsed"/>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
