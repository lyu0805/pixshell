<Window x:Class="PixShell.UI.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑器" Width="860" Height="620" MinWidth="480" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushBg}"
        Foreground="{DynamicResource BrushText}">
    <!-- 内置文本编辑器：头部(文件名+语言徽标+保存/关闭) + 查找替换工具条 +
         行号槽(左) + RichTextBox(右) + 页脚(行:列/字符数/UTF-8)。
         对齐 mac UI/EditorPanel.swift + UI/EditorSyntax.swift。 -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="-1"/>
    </WindowChrome.WindowChrome>
    <DockPanel Margin="12">
        <!-- 头部 -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="False">
            <TextBlock x:Name="FileNameText" DockPanel.Dock="Left" FontSize="14" FontWeight="SemiBold"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="360"
                       Foreground="{DynamicResource BrushText}"/>
            <ContentControl x:Name="LangBadgeHost" DockPanel.Dock="Left" Margin="10,0,0,0" VerticalAlignment="Center"/>
            <Button DockPanel.Dock="Right" Content="关闭" Style="{StaticResource PillButton}" Click="CloseBtn_Click" Margin="8,0,0,0" WindowChrome.IsHitTestVisibleInChrome="True"/>
            <Button DockPanel.Dock="Right" Content="保存" Tag="Primary" Style="{StaticResource PillButton}" Click="SaveBtn_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
            <!-- 保存回报写在编辑器头部（绿 已保存 / 红 保存失败）：mac 版原来写主窗底部状态栏，
                 而编辑器整窗盖住主窗，用户永远看不见。 -->
            <TextBlock x:Name="SaveStatusText" DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="11"
                       Margin="0,0,12,0" Text="" TextTrimming="CharacterEllipsis" MaxWidth="300"/>
        </DockPanel>

        <!-- 查找/替换工具条 -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="False">
            <TextBox x:Name="FindBox" DockPanel.Dock="Left" Width="150" Height="26" VerticalContentAlignment="Center"
                     ToolTip="查找" KeyDown="FindBox_KeyDown"/>
            <Button DockPanel.Dock="Left" Content="▲" Width="26" Height="26" Style="{StaticResource IconButton}"
                    ToolTip="上一个" Click="FindPrevBtn_Click" Margin="4,0,0,0"/>
            <Button DockPanel.Dock="Left" Content="▼" Width="26" Height="26" Style="{StaticResource IconButton}"
                    ToolTip="下一个" Click="FindNextBtn_Click"/>
            <TextBox x:Name="ReplaceBox" DockPanel.Dock="Left" Width="150" Height="26" VerticalContentAlignment="Center"
                     ToolTip="替换为" Margin="10,0,0,0"/>
            <Button DockPanel.Dock="Left" Content="替换" Style="{StaticResource PillButton}" Click="ReplaceOneBtn_Click" Margin="6,0,0,0"/>
            <Button DockPanel.Dock="Left" Content="全部替换" Style="{StaticResource PillButton}" Click="ReplaceAllBtn_Click" Margin="6,0,0,0"/>

            <CheckBox x:Name="WrapCheck" DockPanel.Dock="Right" Content="自动换行" VerticalAlignment="Center"
                      Checked="ToggleWrap" Unchecked="ToggleWrap"/>
            <CheckBox x:Name="LineNumberCheck" DockPanel.Dock="Right" Content="行号" IsChecked="True"
                      VerticalAlignment="Center" Margin="0,0,14,0" Checked="ToggleLineNumbers" Unchecked="ToggleLineNumbers"/>
        </DockPanel>

        <!-- 页脚 -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0" LastChildFill="False">
            <TextBlock x:Name="PosText" DockPanel.Dock="Left" FontSize="11" Foreground="{DynamicResource BrushMuted}" Text="行 1:列 1"/>
            <TextBlock x:Name="CharCountText" DockPanel.Dock="Left" FontSize="11" Foreground="{DynamicResource BrushMuted}" Margin="14,0,0,0" Text="0 字符"/>
            <TextBlock DockPanel.Dock="Left" FontSize="11" Foreground="{DynamicResource BrushMuted}" Margin="14,0,0,0" Text="UTF-8"/>
            <TextBlock x:Name="DirtyText" DockPanel.Dock="Right" FontSize="11" Foreground="{DynamicResource BrushWarn}" Text="● 已修改" Visibility="Collapsed"/>
        </DockPanel>

        <!-- 正文：行号槽 + 编辑区 -->
        <Border BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="{DynamicResource RadiusSm}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="GutterCol" Width="36"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ScrollViewer x:Name="GutterScrollViewer" Grid.Column="0" VerticalScrollBarVisibility="Hidden"
                              HorizontalScrollBarVisibility="Disabled" Background="{DynamicResource BrushBg2}">
                    <TextBlock x:Name="GutterText" FontFamily="{DynamicResource FontMono}" FontSize="10.5"
                               Foreground="{DynamicResource BrushMuted}" TextAlignment="Right"
                               Padding="4,6,6,6" LineHeight="17" LineStackingStrategy="BlockLineHeight"/>
                </ScrollViewer>

                <RichTextBox x:Name="Editor" Grid.Column="1" BorderThickness="0" Background="{DynamicResource BrushBg2}"
                              Foreground="{DynamicResource BrushText}" FontFamily="{DynamicResource FontMono}" FontSize="12"
                              AcceptsTab="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto" Padding="6"/>
            </Grid>
        </Border>
    </DockPanel>
</Window>
