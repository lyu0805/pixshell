<Window x:Class="PixShell.BackupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="备份选项" Width="640" Height="520"
        MinWidth="480" MinHeight="360"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushBg}"
        Foreground="{DynamicResource BrushText}">
    <!-- 备份选项：7 个 provider 卡（本地/WebDAV/GitHub/谷歌云盘/OneDrive/百度/夸克），
         每张卡 启用勾选 + 配置；底部 导出/导入本地包 + 取消/保存配置。对齐 mac UI/BackupPanel.swift。 -->
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Margin="0,0,0,12"
                   Text="默认全部关闭。勾选「启用」并保存后，对应云端同步菜单才会真正执行备份。"
                   Foreground="{DynamicResource BrushMuted}" TextWrapping="Wrap"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <WrapPanel x:Name="CardsPanel" Orientation="Horizontal"/>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="导出本地包…" Style="{StaticResource PillButton}" Margin="0,0,8,0" Click="Export_Click"/>
            <Button Content="导入本地包…" Style="{StaticResource PillButton}" Margin="0,0,24,0" Click="Import_Click"/>
            <Button Content="取消" Style="{StaticResource PillButton}" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="保存配置" Tag="Primary" Style="{StaticResource PillButton}" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
