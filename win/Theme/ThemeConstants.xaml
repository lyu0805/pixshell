<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 与主题无关的常量（圆角/字体），两套主题共用。1:1 对齐 mac UI/Theme.swift。 -->

    <CornerRadius x:Key="RadiusMd">10</CornerRadius>
    <CornerRadius x:Key="RadiusSm">7</CornerRadius>
    <CornerRadius x:Key="RadiusLg">14</CornerRadius>

    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="TopBarHeight">40</sys:Double>

    <!-- 等宽字体（终端/表格数字），带回退链 -->
    <FontFamily x:Key="FontMono">Cascadia Mono, Consolas, Courier New</FontFamily>
    <FontFamily x:Key="FontUi">Segoe UI</FontFamily>
</ResourceDictionary>
