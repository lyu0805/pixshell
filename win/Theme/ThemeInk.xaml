<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 水墨令牌 —— 与 mac 版 UI/Theme.swift 的 .ink 分支 1:1 对齐。
         真·水墨画：冷调**近乎单色的灰白**（远山薄雾那种），整幅只有印章朱砂一点红。
         注意别和「复古」搞混：复古是暖米宣纸 + 矿物颜料，那是做旧调，不是水墨。 -->

    <SolidColorBrush x:Key="BrushBg"          Color="#EEF1F2"/>
    <SolidColorBrush x:Key="BrushBg2"         Color="#F7F9FA"/>
    <SolidColorBrush x:Key="BrushBg3"         Color="#DFE4E6"/>
    <SolidColorBrush x:Key="BrushSide"        Color="#E7EBED"/>
    <SolidColorBrush x:Key="BrushTerm"        Color="#F4F7F8"/>
    <SolidColorBrush x:Key="BrushStatusBg"    Color="#E7EBED"/>
    <!-- 冷墨按浓度化开（#1F2528 + alpha），比中性灰更有纸墨味 -->
    <SolidColorBrush x:Key="BrushBorder"       Color="#1A1F2528"/>
    <SolidColorBrush x:Key="BrushBorderStrong" Color="#2E1F2528"/>
    <SolidColorBrush x:Key="BrushText"         Color="#1F2528"/>
    <SolidColorBrush x:Key="BrushMuted"        Color="#8C1F2528"/>
    <!-- 水墨里几乎不上色：强调色用「焦墨青」这种极低饱和的墨调，不用蓝 -->
    <SolidColorBrush x:Key="BrushAccent"       Color="#4A5A61"/>
    <SolidColorBrush x:Key="BrushAccentHover"  Color="#5D7078"/>
    <SolidColorBrush x:Key="BrushAccentSoft"   Color="#244A5A61"/>
    <SolidColorBrush x:Key="BrushOk"           Color="#5F7A68"/>
    <SolidColorBrush x:Key="BrushWarn"         Color="#8C7A4E"/>
    <!-- 唯一允许的那点颜色：印章朱砂。既符合画面，也保证"出错"仍然醒目 -->
    <SolidColorBrush x:Key="BrushErr"          Color="#9C3D35"/>
    <SolidColorBrush x:Key="BrushControl"      Color="#121F2528"/>
    <SolidColorBrush x:Key="BrushControlHover" Color="#211F2528"/>
    <SolidColorBrush x:Key="BrushFill"         Color="#171F2528"/>
    <SolidColorBrush x:Key="BrushOverlay"      Color="#331F2528"/>
</ResourceDictionary>
