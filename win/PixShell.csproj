<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <Version>0.1.4</Version>
    <AssemblyVersion>0.1.4.0</AssemblyVersion>
    <FileVersion>0.1.4.0</FileVersion>
    <!-- DPI 感知清单：不加的话 WPF 外壳被位图拉伸、WebView2 终端按真实 DPI 渲染，内外缩放对不上 -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationIcon>Resources/AppIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3065.39" />
    <PackageReference Include="SSH.NET" Version="2025.1.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
    <PackageReference Include="System.Drawing.Common" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="web\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- QC logo / 状态栏等运行时读取；exe 图标仍走 ApplicationIcon=.ico -->
    <Resource Include="Resources\AppIcon.png" />
    <Content Include="Resources\AppIcon.png" CopyToOutputDirectory="PreserveNewest" Link="Resources\AppIcon.png" />
    <Content Include="Resources\AppIcon.ico" CopyToOutputDirectory="PreserveNewest" Link="Resources\AppIcon.ico" />
  </ItemGroup>

</Project>
