<UserControl x:Class="PixShell.SftpPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 远端文件浏览器：左侧远端目录树(懒加载) + 右侧明细列表(文件名/大小/类型/修改时间)。
         本地列默认隐藏，可由坞行的"显示/隐藏本地"按钮切换。
         工具条按钮已上移到 bottom-dock 的 [文件][命令] 同一行（见 MainWindow），本面板只放内容区。
         对齐 mac UI/SFTPPanel.swift：⌘/Shift 多选 + 右键菜单 + 拖拽上传 + F5/F2/Delete。 -->
    <Grid Background="{DynamicResource BrushBg}" AllowDrop="True" DragEnter="Panel_DragEnter" Drop="Panel_Drop">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LocalCol" Width="0"/>
            <ColumnDefinition Width="4"/>
            <ColumnDefinition Width="170"/>
            <ColumnDefinition Width="4"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 本地（默认隐藏）。同一列里叠着「本地文件」和「与本机 agent 对话」两种模式，
             由坞行那颗机器人按钮切换；退出对话会还原进来之前的显示状态。 -->
        <ContentControl x:Name="AgentChatHost" Grid.Column="0" Margin="4" Visibility="Collapsed"/>
        <DockPanel x:Name="LocalPanel" Grid.Column="0" Margin="4" Visibility="Collapsed">
            <TextBlock DockPanel.Dock="Top" Text="本地" FontWeight="Bold" FontSize="11"
                       Foreground="{DynamicResource BrushMuted}" Margin="2,0,0,4"/>
            <TextBlock x:Name="LocalPathLabel" DockPanel.Dock="Top" FontSize="10"
                       FontFamily="{DynamicResource FontMono}" Foreground="{DynamicResource BrushMuted}"
                       TextTrimming="CharacterEllipsis" Margin="2,0,0,4"/>
            <ListView x:Name="LocalList" MouseDoubleClick="LocalList_DoubleClick" SelectionMode="Extended"
                      Background="{DynamicResource BrushBg2}" BorderBrush="{DynamicResource BrushBorder}">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="文件名" Width="150">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Icon}" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="大小" Width="70" DisplayMemberBinding="{Binding SizeText}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </DockPanel>
        <GridSplitter x:Name="LocalSplitter" Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                      Background="{DynamicResource BrushBorder}" Visibility="Collapsed"/>

        <!-- 远端目录树（懒加载） -->
        <Border Grid.Column="2" Margin="4" Background="{DynamicResource BrushBg2}"
                BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                CornerRadius="{DynamicResource RadiusSm}">
            <TreeView x:Name="RemoteTree" Background="Transparent" BorderThickness="0"
                      SelectedItemChanged="RemoteTree_SelectedItemChanged"/>
        </Border>

        <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch" Background="{DynamicResource BrushBorder}"/>

        <!-- 远端明细：文件名/大小/类型/修改时间 -->
        <DockPanel Grid.Column="4" Margin="4">
            <TextBlock x:Name="StatusLabel" DockPanel.Dock="Bottom" FontSize="10"
                       Foreground="{DynamicResource BrushMuted}" Margin="2,4,0,0"/>
            <ListView x:Name="RemoteList" MouseDoubleClick="RemoteList_DoubleClick"
                      SelectionMode="Extended" PreviewKeyDown="RemoteList_PreviewKeyDown"
                      Background="{DynamicResource BrushBg2}" BorderBrush="{DynamicResource BrushBorder}">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                        <EventSetter Event="PreviewMouseRightButtonDown" Handler="RemoteItem_PreviewMouseRightButtonDown"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="打开 / 进入" Click="CtxOpen_Click"/>
                        <MenuItem Header="下载" Click="CtxDownload_Click"/>
                        <Separator/>
                        <MenuItem Header="上传到此目录…" Click="CtxUpload_Click"/>
                        <MenuItem Header="新建目录…" Click="CtxMkdir_Click"/>
                        <MenuItem Header="重命名…" Click="CtxRename_Click"/>
                        <MenuItem Header="删除" Click="CtxDelete_Click"/>
                        <Separator/>
                        <MenuItem Header="复制路径" Click="CtxCopyPath_Click"/>
                        <MenuItem Header="插入命令框" Click="CtxInsertToCommand_Click"/>
                        <Separator/>
                        <MenuItem Header="刷新" Click="CtxRefresh_Click"/>
                    </ContextMenu>
                </ListView.ContextMenu>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="文件名" Width="260">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Icon}" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="大小" Width="80" DisplayMemberBinding="{Binding SizeText}"/>
                        <GridViewColumn Header="类型" Width="60" DisplayMemberBinding="{Binding TypeText}"/>
                        <GridViewColumn Header="修改时间" Width="140" DisplayMemberBinding="{Binding TimeText}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </DockPanel>
    </Grid>
</UserControl>
